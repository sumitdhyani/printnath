generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id          String   @id @default(uuid())
  phone       String   @unique
  whatsappId  String?  @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  documents   Document[]
  sessions    CustomerSession[]
  printJobs   PrintJob[]
  payments    Payment[]
}

model Shop {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  address      String?
  contactPhone String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  gateways     Gateway[]
  pricings     Pricing[]
  sessions     CustomerSession[]
  printJobs    PrintJob[]
}

model Gateway {
  id             String    @id @default(uuid())
  deviceId       String    @unique
  shopId         String?
  shop           Shop?     @relation(fields: [shopId], references: [id])
  softwareVer    String?
  lifecycleState String    @default("PRE_ACTIVATION")
  activationCode String?
  activatedAt    DateTime?
  lastHeartbeat  DateTime?
  isConnected    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  printers       Printer[]
  printJobs      PrintJob[]
}

model Printer {
  id             String   @id @default(uuid())
  gatewayId      String
  gateway        Gateway  @relation(fields: [gatewayId], references: [id])
  name           String
  type           String?
  state          String   @default("UNKNOWN")
  capabilities   Json?
  supportsColor  Boolean  @default(false)
  supportsDuplex Boolean  @default(false)
  supportsA3     Boolean  @default(false)
  reportedAt     DateTime?
  createdAt      DateTime @default(now())

  @@unique([gatewayId, name])
}

model Pricing {
  id         String   @id @default(uuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id])
  pageType   String
  pricePaise Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shopId, pageType])
}

model Document {
  id           String   @id @default(uuid())
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  originalName String
  mimeType     String
  fileSize     BigInt
  pageCount    Int?
  storageKey   String
  source       String
  sessionToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  jobDocuments JobDocument[]
}

model CustomerSession {
  id           String    @id @default(uuid())
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  sessionToken String    @unique
  state        String    @default("LANDING")
  mode         String    @default("ANONYMOUS")
  phone        String?   // phone number, stored for OTP flow
  authMethod   String?
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  metadata     Json?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  printJobs    PrintJob[]
}

model PrintJob {
  id               String   @id @default(uuid())
  jobNumber        String   @unique
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id])
  gatewayId        String?
  gateway          Gateway? @relation(fields: [gatewayId], references: [id])
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  sessionId        String?
  session          CustomerSession? @relation(fields: [sessionId], references: [id])
  state            String   @default("CREATED")
  requirements     Json
  totalPages       Int
  pricePaise       Int
  platformFeePaise Int      @default(0)
  shopEarningsPaise Int?
  artifactKey      String?
  errorReason      String?
  retryCount       Int      @default(0)
  expiresAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  payments         Payment[]
  jobDocuments     JobDocument[]
}

model JobDocument {
  jobId      String
  documentId String
  pageCount  Int
  job        PrintJob  @relation(fields: [jobId], references: [id])
  document   Document  @relation(fields: [documentId], references: [id])

  @@id([jobId, documentId])
}

model Payment {
  id            String    @id @default(uuid())
  jobId         String
  job           PrintJob  @relation(fields: [jobId], references: [id])
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  amountPaise   Int
  currency      String    @default("INR")
  provider      String
  providerRef   String?
  status        String    @default("PENDING")
  failureReason String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([provider, providerRef])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  entityType String
  entityId   String
  event      String
  fromState  String?
  toState    String?
  metadata   Json?
  createdAt  DateTime @default(now())
}