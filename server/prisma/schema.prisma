generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Device owner (shopkeeper, hostel warden, etc.) ──

model Owner {
  phone       String    @id               // E.164, primary identifier
  displayName String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  gateways    Gateway[]
  pricings    Pricing[]
}

// ── Gateway device ──

model Gateway {
  id             String    @id @default(uuid())
  deviceId       String    @unique
  ownerPhone     String?
  owner          Owner?    @relation(fields: [ownerPhone], references: [phone])
  name           String?              // "Main St Print Shop"
  locationDesc   String?              // "Near City Mall, Delhi"
  softwareVer    String?
  lifecycleState String    @default("PRE_ACTIVATION")
  deviceToken    String?              // Issued after activation
  lastHeartbeat  DateTime?
  capabilities   Json?
  isConnected    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       CustomerSession[]
  printJobs      PrintJob[]
}


// ── Owner pricing (linked to owner phone, not gateway) ──

model Pricing {
  id         String   @id @default(uuid())
  ownerPhone String
  owner      Owner    @relation(fields: [ownerPhone], references: [phone])
  pageType   String               // B_W_A4 | COLOR_A4 | B_W_A3 | COLOR_A3
  pricePaise Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([ownerPhone, pageType])
}

// ── Customer session (browser flow) ──

model CustomerSession {
  id           String    @id @default(uuid())
  gatewayId    String
  gateway      Gateway   @relation(fields: [gatewayId], references: [id])
  sessionToken String    @unique
  state        String    @default("LANDING")
  mode         String    @default("ANONYMOUS")
  phone        String?              // Customer phone for OTP auth
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  metadata     Json?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  printJobs    PrintJob[]
}

// ── Customer-submitted document ──

model Document {
  id           String   @id @default(uuid())
  sessionToken String
  originalName String
  mimeType     String
  fileSize     BigInt
  pageCount    Int?
  storageKey   String
  source       String               // WHATSAPP | DIRECT_UPLOAD
  fileHash     String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  jobDocuments JobDocument[]
}

// ── Print job lifecycle ──

model PrintJob {
  id               String   @id @default(uuid())
  jobNumber        String   @unique
  gatewayId        String?
  gateway          Gateway? @relation(fields: [gatewayId], references: [id])
  sessionId        String?
  session          CustomerSession? @relation(fields: [sessionId], references: [id])
  state            String   @default("CREATED")
  totalPages       Int       // Σ(jobDocument.pageCount × jobDocument.copies)
  pricePaise       Int
  platformFeePaise Int      @default(0)
  artifactKey      String?
  errorReason      String?
  retryCount       Int      @default(0)
  expiresAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  payments         Payment[]
  jobDocuments     JobDocument[]
}

// ── Job-document join (per-document config) ──

model JobDocument {
  jobId      String
  documentId String
  pageCount  Int        // pages in this document
  copies     Int        @default(1)
  color      Boolean    @default(false)
  duplex     Boolean    @default(false)
  paperSize  String     @default("A4")
  pricePaise Int        // total: pageCount × copies × pricing rate
  job        PrintJob   @relation(fields: [jobId], references: [id])
  document   Document   @relation(fields: [documentId], references: [id])

  @@id([jobId, documentId])
}

// ── Payments ──

model Payment {
  id            String    @id @default(uuid())
  jobId         String
  job           PrintJob  @relation(fields: [jobId], references: [id])
  amountPaise   Int
  currency      String    @default("INR")
  provider      String
  providerRef   String?
  status        String    @default("PENDING")
  failureReason String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([provider, providerRef])
}

// ── Immutable audit log ──

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  entityType String
  entityId   String
  event      String
  fromState  String?
  toState    String?
  metadata   Json?
  createdAt  DateTime @default(now())
}